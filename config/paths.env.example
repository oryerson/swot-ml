# SWOT-GAT site configuration: the ONLY file with machine-specific paths.
# Copy to config/paths.env, edit, then `source config/paths.env` in every shell
# (and before every sbatch) that runs pipeline steps. Python reads the same file.

# --- where things live -------------------------------------------------------
# Work tree: all intermediate and final data, laid out as docs/DATA_LAYOUT.md
# describes. Needs about 1 TB for the full pipeline.
export SWOTGAT_WORK=/path/to/swotgat_work
# File system whose free space the store-building checks report.
export SWOTGAT_WORK_FS=${SWOTGAT_WORK}
# Raw-data archives (read-only). docs/DATA_SOURCES.md lists what must be under each.
export SWOTGAT_NAS_ICE=/path/to/archive_ice      # MERIT-Hydro, MERIT-Basins, HydroATLAS, ERA5-Land, SWOT RiverSP
export SWOTGAT_NAS_WATER=/path/to/archive_water  # LakeSP version C series, MERIT-SWORD table, GDW

# --- Python environments (see environment/README.md) --------------------------
export SWOTGAT_PYTHON=/path/to/swot-ml-venv/bin/python              # model, data, scoring, figures (Python 3.11)
export SWOTGAT_DELINEATOR_PYTHON=/path/to/delineator-venv/bin/python # graph delineation and graph builds (Python 3.12)
export SWOTGAT_HALF_PYTHON=/path/to/half-venv/bin/python            # HALF lake filtering
export SWOTGAT_CDS_PYTHON=/path/to/cds-venv/bin/python              # Copernicus CDS downloads (needs your own ~/.cdsapirc)

# --- trained models ------------------------------------------------------------
# Run-folder names under $SWOTGAT_WORK/CONUS (seed 0 and seed 1). The defaults are
# the paper's runs, whose checkpoints are in the data archive. After training your
# own, put the new folder names here.
export SWOTGAT_RUN_S1=era5_conus_v35c5_S1_storage_20261028_074428
export SWOTGAT_RUN_S2=era5_conus_v35c5_S2_storage_s1_20261028_085321

# --- Slurm flags for your cluster ---------------------------------------------
export SWOTGAT_SBATCH_CPU="--account=YOUR_ACCOUNT --partition=YOUR_CPU_PARTITION"
export SWOTGAT_SBATCH_GPU="--account=YOUR_ACCOUNT --partition=YOUR_GPU_PARTITION --gres=gpu:1"
# CUDA toolkit folder for XLA (leave empty if your JAX wheels bundle CUDA).
export SWOTGAT_CUDA_DIR=

# --- derived; do not edit -----------------------------------------------------
export SWOTGAT_REPO="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
export PYTHONPATH="${SWOTGAT_REPO}/src${PYTHONPATH:+:$PYTHONPATH}"
